# ── PriceIQ Go API (backend-go) ──────────────────────────────────────────────
APP_ENV=development                 # production forbids AUTH_PROVIDER=local
PORT=8080

# PostgreSQL.
# Supabase: Project → Connect → "Transaction pooler" string
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   (the direct host db.<ref>.supabase.co is IPv6-only and not resolvable on every network).
#   Percent-encode special characters in the password. Use the same value in backend/.env.
# Local fallback (go run ./cmd/devdb):
#   postgres://postgres:postgres@localhost:54322/priceiq?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:54322/priceiq?sslmode=disable
DB_MAX_CONNS=10
MIGRATIONS_DIR=../supabase/migrations

# Optional Redis (cache, rate limiting, job locks). Without it an in-memory cache is used (single instance only).
# REDIS_URL=redis://localhost:6379/0

# Authentication: "supabase" (Supabase Auth tokens) or "local" (the API issues dev tokens itself;
# works on the local database and on a Supabase database; refused in production)
AUTH_PROVIDER=local
# Supabase mode — at least one of these:
SUPABASE_URL=                       # https://<project>.supabase.co (enables JWKS verification of ES256/RS256 tokens)
SUPABASE_JWT_SECRET=                # legacy HS256 JWT secret (Project Settings → API → JWT secret)
SUPABASE_JWT_AUD=authenticated
# Only for `go run ./cmd/seed` in Supabase mode (creates demo users via the Admin API). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Local mode:
LOCAL_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
LOCAL_TOKEN_TTL=12h

# Python AI service (internal). The token must match backend/.env.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-shared-internal-secret
AI_TIMEOUT=60s                      # raise (e.g. 180s) when the database is hosted far away

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300

# Background jobs
WORKERS_ENABLED=true
ALERT_SCAN_INTERVAL=15m
COMPETITOR_REFRESH_INTERVAL=6h
AUTO_PRICING_INTERVAL=1h
ML_REFRESH_INTERVAL=24h

# Optional e-mail for HIGH/CRITICAL alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Demo seed password (cmd/seed)
SEED_DEMO_PASSWORD=PriceIQ@2026!
