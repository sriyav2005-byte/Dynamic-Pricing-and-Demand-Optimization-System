# Go API base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Supabase Auth: project URL + the publishable (anon) key — the only Supabase key that may be in the browser.
# Leave the key empty to use the Go API's local dev auth. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
