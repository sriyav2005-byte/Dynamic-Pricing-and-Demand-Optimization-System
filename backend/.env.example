# ── PriceIQ AI service (backend/, Python + FastAPI) ─────────────────────────
# Same database as the Go API (service/owner role): copy DATABASE_URL from backend-go/.env
# (Supabase transaction pooler, or the local fallback below). The AI service only acts on
# store/product ids that the Go API has already authorized.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/priceiq
# Shared secret; must equal AI_SERVICE_TOKEN in backend-go/.env
AI_SERVICE_TOKEN=change-me-shared-internal-secret
# Go API base URL (the copilot's tools call it with the end user's token)
GO_API_URL=http://localhost:8080

# Retail Copilot LLM (optional) — OpenRouter, an OpenAI-compatible gateway.
# LLM mode needs provider, key and model. Without them — or when OpenRouter is
# down, slow or rate-limited — a rule-based assistant answers from the same
# tools, and every reply says which mode produced it.
#   AI_PROVIDER         openrouter | none   (none = never call an external LLM)
#   OPENROUTER_API_KEY  create one at https://openrouter.ai/keys — keep it in backend/.env only
#   AI_MODEL            openrouter/free lets OpenRouter pick an available free model that supports
#                       tool calling; or any model id from https://openrouter.ai/models
#   OPENROUTER_SITE_URL / OPENROUTER_APP_NAME   optional attribution headers (HTTP-Referer, X-Title)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PriceIQ
# AI_TIMEOUT_S=30
# AI_MAX_TOKENS=2048
# AI_BUDGET_S=40        # whole LLM answer incl. tool rounds; keep below the Go API's AI_TIMEOUT
# Optional hosted embeddings for RAG (default: local hashing embedder)
VOYAGE_API_KEY=

# Pricing policy: model_ts (default, Thompson Sampling) or contextual_ts (challenger; validate first)
PRICING_POLICY=model_ts

# Competitor fetching (Blinkit needs Playwright + Chromium: python -m playwright install chromium)
PLAYWRIGHT_ENABLED=true
SCRAPE_TIMEOUT_S=35
# Fallback coordinates for weather when a store has no latitude/longitude
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946
