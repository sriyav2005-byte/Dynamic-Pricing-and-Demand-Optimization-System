# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# ── ML / Model artifacts ─────────────────────────────────────────────────────
# Serialised model files are large binaries — retrain locally (see README)
*.pkl

# ── Database ──────────────────────────────────────────────────────────────────
# Stray local database files (PriceIQ uses PostgreSQL)
*.db
*.sqlite3

# ── Next.js / Node ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/

# Dependency lock files (optional — remove if you want to commit them)
# package-lock.json

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
# Local embedded Postgres (backend-go/cmd/devdb)
backend-go/.devdata/
backend-go/.devdb.log
backend-go/*.exe
backend-go/.server.log
backend-go/.ai.log
backend-go/.web.log
